# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=FRIDAY AI
APP_VERSION=4.2.1
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM (ollama | groq | gemini) ─────────────────────────────────────────────
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Groq (cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Voice ────────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
TTS_ENGINE=edge

# ElevenLabs (cloud TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Memory / embeddings ──────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text

# ── Infra (Postgres + Redis) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://friday:friday@127.0.0.1:5432/friday
REDIS_URL=redis://127.0.0.1:6379/0

# ── Storage paths ────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./storage/embeddings
CONVERSATIONS_PATH=./storage/conversations
UPLOADS_PATH=./storage/uploads
LOGS_PATH=./storage/logs

# Secret code for confirming dangerous actions (Jarvis asks you to speak this)
CONFIRM_CODE=7989
